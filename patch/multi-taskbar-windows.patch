+void CTaskbarHelper::GetAllTaskbarWnd(std::vector<TaskbarWnd>& taskbars)
+{
+    taskbars.clear();
+    //主显示器的任务栏
+    HWND h_primary = ::FindWindow(_T("Shell_TrayWnd"), NULL);
+    if (h_primary != nullptr)
+        taskbars.push_back(TaskbarWnd{ h_primary, false });
+    //副显示器的任务栏
+    std::vector<HWND> secondary_taskbars;
+    GetAllSecondaryDisplayTaskbar(secondary_taskbars);
+    for (HWND h : secondary_taskbars)
+        taskbars.push_back(TaskbarWnd{ h, true });
+}
